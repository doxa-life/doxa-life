# doxa-maps frame policy — generated by internal/generate-tree.mjs
# (see docs/architecture/embeddability.md — the server owns frame-ancestors)

# Staging surfaces: internal preview only
/doxa-maps/index.html
  Content-Security-Policy: frame-ancestors 'self'
/doxa-maps/:bundle/index.html
  Content-Security-Policy: frame-ancestors 'self'

# Direct-embed pages (the product): framable on any partner site
/doxa-maps/:bundle/:profile/index.html
  Content-Security-Policy: frame-ancestors *
/doxa-maps/:bundle/:profile/:instance/index.html
  Content-Security-Policy: frame-ancestors *
